<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Product Management</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css" rel="stylesheet">
  <link rel="stylesheet" href="/admin/sidebar.css">

  <style>
    .main-content {
      margin-left: 250px;
      padding: 30px;
    }
    @media (max-width: 768px) {
      .main-content {
        margin-left: 0;
        padding: 15px;
      }
    }
    .page-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 25px;
    }
    .table thead {
      background-color: #f1f1f1;
    }
    .btn-add {
      background-color: #3f37c9;
      color: #fff;
    }
    .product-img {
      width: 60px;
      height: 60px;
      object-fit: cover;
      border-radius: 6px;
    }
  </style>
</head>
<body>

  <!-- Sidebar -->
  <%- include("sidebar") %>

  <!-- Main Content -->
  <div class="main-content">
    <div class="page-header">
      <h2><i class="bi bi-box-seam me-2"></i> Product Management</h2>
      <a href="/admin/products/add" class="btn btn-add"><i class="bi bi-plus-lg"></i> Add Product</a>
    </div>

    <div class="table-responsive">
      <table class="table table-bordered align-middle">
        <thead>
          <tr>
            <th>#</th>
            <th>Image</th>
            <th>Product Name</th>
            <th>Price (₹)</th>
            <th>Stock</th>
            <th>Category</th>
            <th>Status</th>
            <th>Action</th>
          </tr>
        </thead>
        <tbody>
          <% products.forEach((product, index) => { %>
            <tr>
              <td><%= index + 1 %></td>
              <td><img src="/uploads/products/<%= product.image %>" alt="Product" class="product-img"></td>
              <td><%= product.name %></td>
              <td><%= product.price %></td>
              <td><%= product.stock %></td>
              <td><%= product.category %></td>
              <td>
                <% if(product.status === 'Active') { %>
                  <span class="badge bg-success">Active</span>
                <% } else { %>
                  <span class="badge bg-danger">Inactive</span>
                <% } %>
              </td>
              <td>
                <a href="/admin/products/edit/<%= product.id %>" class="btn btn-sm btn-warning"><i class="bi bi-pencil"></i></a>
                <a href="/admin/products/delete/<%= product.id %>" class="btn btn-sm btn-danger" onclick="return confirm('Are you sure?')"><i class="bi bi-trash"></i></a>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>

  <script src="/admin/sidebar.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
