<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Admin Dashboard</title>

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"/>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet"/>

  <style>
    body {
      margin: 0;
      padding: 0;
      background-color: #f8f9fa;
    }

    .main-content {
      margin-left: 250px;
      padding: 20px;
    }

    .stats-card {
      border: 1px solid #dee2e6;
      border-radius: 10px;
      margin-bottom: 20px;
      transition: transform 0.2s ease-in-out;
    }

    .stats-card:hover {
      transform: translateY(-5px);
    }

    .card-icon {
      font-size: 2rem;
      margin-bottom: 10px;
    }

    .badge-pill {
      padding: 6px 12px;
      border-radius: 20px;
      font-size: 0.875rem;
    }

    .container-box {
      background-color: white;
      border-radius: 8px;
      box-shadow: 0 0 10px rgba(0,0,0,0.1);
      padding: 20px;
    }
  </style>
</head>
<body>

  <!-- Include Sidebar -->
  <%- include("sidebar") %>

  <!-- Main Dashboard Content -->
  <div class="main-content">
    <div class="container-box">

      <!-- Stats Cards -->
      <div class="row">
        <div class="col-lg-4 col-md-6">
          <div class="stats-card p-3 text-center">
            <div class="card-icon text-primary"><i class="bi bi-people"></i></div>
            <h5 class="card-title">TOTAL USERS</h5>
            <h2 class="card-value">1,248</h2>
          </div>
        </div>
        <div class="col-lg-4 col-md-6">
          <div class="stats-card p-3 text-center">
            <div class="card-icon text-success"><i class="bi bi-box-seam"></i></div>
            <h5 class="card-title">TOTAL PRODUCTS</h5>
            <h2 class="card-value">586</h2>
          </div>
        </div>
        <div class="col-lg-4 col-md-12">
          <div class="stats-card p-3 text-center">
            <div class="card-icon text-warning"><i class="bi bi-cart-check"></i></div>
            <h5 class="card-title">TOTAL ORDERS</h5>
            <h2 class="card-value">2,347</h2>
          </div>
        </div>
      </div>

      <!-- Recent Orders Table -->
      <div class="recent-orders">
        <h5 class="card-title mb-3">Recent Orders</h5>

        <!-- Print Button -->
        <div class="text-end mb-2">
          <button class="btn btn-sm btn-primary" onclick="printOrders()">
            <i class="bi bi-printer"></i> Print Orders
          </button>
        </div>

        <div class="table-responsive">
          <table class="table table-bordered text-center align-middle">
            <thead class="table-light">
              <tr>
                <th>Order ID</th>
                <th>Customer</th>
                <th>Amount</th>
                <th>Date</th>
                <th>Status</th>
                <th>Action</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td>ORD101</td>
                <td>Suraj Jadhav</td>
                <td>₹450</td>
                <td>2025-07-04</td>
                <td><span class="badge bg-success badge-pill">Delivered</span></td>
                <td><a href="#" class="text-primary">View</a></td>
              </tr>
              <tr>
                <td>ORD102</td>
                <td>Rahul More</td>
                <td>₹780</td>
                <td>2025-07-03</td>
                <td><span class="badge bg-warning text-dark badge-pill">Pending</span></td>
                <td><a href="#" class="text-primary">View</a></td>
              </tr>
              <tr>
                <td>ORD103</td>
                <td>Aarti Patil</td>
                <td>₹320</td>
                <td>2025-07-02</td>
                <td><span class="badge bg-primary badge-pill">Processing</span></td>
                <td><a href="#" class="text-primary">View</a></td>
              </tr>
              <!-- ... more rows as needed ... -->
            </tbody>
          </table>
        </div>

        <div class="text-end mt-3">
          <a href="#" class="btn btn-outline-primary">View All Orders</a>
        </div>
      </div>
    </div>
  </div>

  <!-- JS -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    function printOrders() {
      const content = document.querySelector(".recent-orders").innerHTML;
      const printWindow = window.open('', '', 'height=600,width=800');
      printWindow.document.write(`
        <html>
        <head>
          <title>Print Orders</title>
          <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
          <style>
            body { padding: 20px; font-family: Arial, sans-serif; }
            table { width: 100%; border-collapse: collapse; }
            th, td { border: 1px solid #ddd; padding: 8px; text-align: center; }
            th { background-color: #f2f2f2; }
          </style>
        </head>
        <body>
          <h2 class="mb-3">Recent Orders</h2>
          ${content}
        </body>
        </html>
      `);
      printWindow.document.close();
      printWindow.focus();
      printWindow.print();
      printWindow.close();
    }
  </script>
</body>
</html>
