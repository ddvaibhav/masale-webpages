

  <style>
    .main-content {
      margin-left: 250px;
      padding: 30px;
    }
    @media (max-width: 768px) {
      .main-content {
        margin-left: 0;
        padding: 15px;
      }
    }
    .page-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 25px;
    }
    .table thead {
      background-color: #f1f1f1;
    }
    .btn-add {
      background-color: #3f37c9;
      color: #fff;
    }
    .product-img {
      width: 60px;
      height: 60px;
      object-fit: cover;
      border-radius: 6px;
    }
  </style>


  <!-- Sidebar -->
  <%- include("sidebar") %>

  <!-- Main Content -->
  <div class="main-content">
    <div class="page-header">
      <h2><i class="bi bi-box-seam me-2"></i> Product Management</h2>
      <a href="/admin/add_product" class="btn btn-add"><i class="bi bi-plus-lg"></i> Add Product</a>
    </div>

    <div class="table-responsive">
      <table class="table table-bordered align-middle">
       <thead>
  <tr>
    <th>#</th>
    <th>frant Image</th>
    <th>back Image</th>
    <th>Name</th>
    <th>Code</th>
    <th>Category</th>
    <th>Subcategory</th>
    <th>Brand</th>
    <th>Unit</th>
    <th>Stock</th>
    <th>Cost Price</th>
    <th>Selling Price</th>
    <th>Discount (%)</th>
    <th>GST (%)</th>
    <th>Final Price</th>
    <th>Expiry</th>
    <th>Status</th>
    <th>Featured</th>
    <th>Short Desc</th>
    <th>Long Desc</th>
    <th>Added Date</th>
    <th>Action</th>
  </tr>
</thead>
<tbody>
  <% for (let i = 0; i < products.length; i++) { %>
    <tr>
      <td><%= i + 1 %></td>
      <td>
        <a href="/admin/products/edit/<%= products[i].id %>">
          <img src="/uploads/products/<%= products[i].frant_image%>" alt="Product" class="product-img">
        </a>
      </td>
      <td>
        <a href="/admin/products/edit/<%= products[i].id %>">
          <img src="/uploads/products/<%= products[i].back_image%>" alt="Product" class="product-img">
        </a>
      </td>
      <td><%= products[i].name %></td>
      <td><%= products[i].code %></td>
      <td><%= products[i].category %></td>
      <td><%= products[i].subcategory %></td>
      <td><%= products[i].brand %></td>
      <td><%= products[i].unit %></td>
      <td><%= products[i].stock %></td>
      <td><%= products[i].cost_price %></td>
      <td><%= products[i].selling_price %></td>
      <td><%= products[i].discount %></td>
      <td><%= products[i].gst %></td>
      <td><%= products[i].final_price %></td>
      <td><%= products[i].added_date ? products[i].added_date.toISOString().split("T")[0] : "N/A" %></td>

      <td>
        <% if(products[i].status === 'Active') { %>
          <span class="badge bg-success">Active</span>
        <% } else { %>
          <span class="badge bg-danger">Inactive</span>
        <% } %>
      </td>
      <td><%= products[i].featured %></td>
      <td><%= products[i].short_desc %></td>
      <td><%= products[i].long_desc %></td>
      <td><%= products[i].added_date ? products[i].added_date.toISOString().split("T")[0] : "N/A" %></td>
      <td class="text-nowrap">
  <a href="/admin/edit_product/<%= products[i].id %>" class="btn btn-sm btn-primary me-1">
    <i class="bi bi-pencil-square"></i>
  </a>
  <a href="/admin/delete/<%= products[i].id %>" class="btn btn-sm btn-danger" onclick="return confirm('Are you sure?')">
    <i class="bi bi-trash"></i>
  </a>
</td>

    </tr>
  <% } %>
</tbody>


      </table>
    </div>
  </div>
<script>
  console.log(products)
</script>
