<%- include("navbar") %>

<style>
  body {
    font-family: 'Segoe UI', sans-serif;
    background-color: #f9f9f9;
    margin: 0;
  }

  .main-content {
    padding: 40px 30px;
    min-height: 100vh;
  }

  .section-heading {
    font-size: 28px;
    font-weight: 600;
    margin-bottom: 30px;
    color: #333;
    border-left: 6px solid #ffa733;
    padding-left: 15px;
  }

  .feature-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 25px;
  }

  .feature-card {
    flex: 1 1 250px;
    background: #ffffff;
    border-radius: 16px;
    box-shadow: 0 8px 16px rgba(0,0,0,0.06);
    padding: 25px;
    text-align: center;
    transition: 0.3s ease;
  }

  .feature-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 12px 20px rgba(0,0,0,0.08);
  }

  .feature-icon {
    width: 70px;
    height: 70px;
    border-radius: 50%;
    background: #ffa733;
    color: white;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 20px;
    font-size: 24px;
  }

  .feature-title {
    font-size: 18px;
    font-weight: 600;
    margin-bottom: 10px;
    color: #333;
  }

  .feature-description {
    font-size: 14px;
    color: #666;
    margin-bottom: 15px;
  }

  .edit-link {
    text-decoration: none;
    color: #007bff;
    font-weight: 500;
  }

  @media (max-width: 768px) {
    .main-content {
      margin-left: 0;
      padding: 20px;
    }
  }
</style>


<div class="main-content" style=" padding: 40px 30px; min-height: 100vh; background: #f9f9f9;">
  <h2>Why Choose Us</h2>

  <div style="display: flex; flex-wrap: wrap; gap: 25px;">
    <% for (var i = 0; i < data.length; i++) { %>
      <div style="flex: 1 1 250px; background: #fff; padding: 20px; border-radius: 12px; text-align: center; box-shadow: 0 4px 10px rgba(0,0,0,0.05);">
        
        <!-- ✅ Feature Image -->
        <img src="/images/<%= data[i].image %>" width="70" height="70" style="border-radius: 50%; object-fit: cover; margin-bottom: 15px;">

        <!-- ✅ Title + Description -->
        <h4 style="margin-bottom: 10px;"><%= data[i].title %></h4>
        <p style="font-size: 14px; color: #555;"><%= data[i].description %></p>

        <!-- ✅ Edit Button -->
        <a href="/admin/edit/<%= data[i].id %>" 
           style="display: inline-block; margin-top: 10px; padding: 8px 18px; background-color: #ffa733; color: white; border-radius: 6px; text-decoration: none; transition: 0.3s;">
          ✏️ Edit
        </a>
      </div>
    <% } %>
  </div>
</div>



<%- include("footer") %>
