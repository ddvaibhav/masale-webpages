<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Dashboard</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">
   <link rel="stylesheet" href="/admin/sidebar.css">
</head>
<body>
    <button class="sidebar-toggle" id="sidebarToggle">
        <i class="bi bi-list"></i>
    </button>
    
    <!-- Sidebar -->
    <div class="sidebar">
        <div class="sidebar-brand">
            <h4><i class="bi bi-gear"></i> Admin<span>Panel</span></h4>
        </div>
        
        <ul class="nav flex-column sidebar-nav">
            <li class="nav-item">
                <a href="/admin" class="nav-link active">
                    <i class="bi bi-speedometer2"></i>
                    Dashboard
                </a>
            </li>
            <li class="nav-item">
                <a href="/admin/users" class="nav-link">
                    <i class="bi bi-people"></i>
                    Users
                </a>
            </li>
            <li class="nav-item dropdown">
                                <a href="#" class="nav-link toggle-submenu" data-target="productsMenu">
                    <i class="bi bi-box-seam"></i> Products
                </a>
                <ul class="submenu" id="productsMenu">
                    <li><a href="/admin/products" class="nav-link">All Products</a></li>
                    <li><a href="/admin/add_product" class="nav-link">Add Products</a></li>
                </ul>

            </li>
           <li class="nav-item dropdown">
                        <a href="#" class="nav-link toggle-submenu" data-target="ordersMenu">
                <i class="bi bi-cart-check"></i> Orders
            </a>
            <ul class="submenu" id="ordersMenu">
                <li><a href="/admin/all_orders" class="nav-link">All Orders</a></li>
                <li><a href="#" class="nav-link">Pending Orders</a></li>
                <li><a href="#" class="nav-link">Completed Orders</a></li>
            </ul>

            </li>

            <li class="nav-item">
                <a href="#  " class="nav-link">
                    <i class="bi bi-graph-up"></i>
                    Reports
                </a>
            </li>
            <li class="nav-item">
                <a href="#" class="nav-link">
                    <i class="bi bi-sliders"></i>
                    Settings
                </a>
            </li>
            <li class="nav-item mt-4">
                <a href="/admin/logout" class="nav-link">
                    <i class="bi bi-box-arrow-right"></i>
                    Logout
                </a>
            </li>
        </ul>
    </div>
    
    <!-- Main Content -->
    <div class="main-content">
        <!-- Top Bar -->
        <div class="top-bar mb-4 animated-content">
            <div class="row align-items-center">
                <div class="col-lg-4 col-md-6 mb-3 mb-md-0">
                    <div class="welcome-text">
                        <h1>Welcome back, Admin!</h1>
                        <p>Here's what's happening with your store today.</p>
                    </div>
                </div>
                <div class="col-lg-4 col-md-6 mb-3 mb-md-0">
                    <div class="search-bar">
                        <i class="bi bi-search"></i>
                        <input type="text" placeholder="Search...">
                    </div>
                </div>
                <div class="col-lg-4 col-md-12">
                    <div class="user-actions">
                        <button class="notification-btn">
                            <i class="bi bi-bell"></i>
                            <span class="badge">3</span>
                        </button>
                       <div class="user-actions position-relative">
                        <button class="notification-btn">
                            <i class="bi bi-bell"></i>
                            <span class="badge">3</span>
                        </button>
                        <!-- User Dropdown Toggle Button -->
                        <button class="user-btn dropdown-toggle" id="userDropdownToggle" data-bs-toggle="dropdown" aria-expanded="false">
                        <div class="user-avatar">A</div>
                        <span>Admin <i class="bi bi-chevron-down"></i></span>
                        </button>

                        <!-- Dropdown Menu -->
                        <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="userDropdownToggle">
                        <li><a class="dropdown-item" href="/admin/profile">Profile</a></li>
                        <li><hr class="dropdown-divider"/></li>
                        <li><a class="dropdown-item" href="/admin/logout">Logout</a></li>
                        </ul>

                    </div> 
                    </div>
                </div>
            </div>
        </div>
        </div>
        <!-- Script files -->
<script src="/admin/sidebar.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
