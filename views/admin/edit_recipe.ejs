<%- include("navbar") %>

<div class="container mt-5">
  <h2 class="mb-4">Edit Recipe</h2>
  <form action="/admin/update_recipe" method="POST" enctype="multipart/form-data" class="p-4 bg-light rounded shadow">
    <input type="hidden" name="id" value="<%= result[0].id %>">

    <div class="mb-3">
      <label class="form-label">Title</label>
      <input type="text" name="title" class="form-control" value="<%= result[0].title %>" required>
    </div>

    <div class="mb-3">
      <label class="form-label">Description</label>
      <textarea name="description" class="form-control" rows="4" required><%= result[0].description %></textarea>
    </div>

    <div class="mb-3">
      <label class="form-label">Duration</label>
      <input type="text" name="duration" class="form-control" value="<%= result[0].duration %>">
    </div>

    <div class="mb-3">
      <label class="form-label">Current Image</label><br>
      <img src="/images/<%= result[0].image %>?v=<%= Date.now() %>" alt="Current Image" class="img-thumbnail mb-2" style="max-height: 150px;">
      <input type="file" name="image" class="form-control">
    </div>

    <div class="d-flex justify-content-end">
      <button type="submit" class="btn btn-success">Update Recipe</button>
    </div>
  </form>
</div>

<%- include("footer") %>
