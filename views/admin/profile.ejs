

  <style>
    .main-content {
      margin-left: 250px;
      padding: 30px;
    }
    @media (max-width: 768px) {
      .main-content {
        margin-left: 0;
        padding: 15px;
      }
    }
    .profile-card {
      border-radius: 15px;
      background: #fff;
      padding: 30px;
      box-shadow: 0 0 10px rgba(0,0,0,0.1);
    }
    .profile-header {
      background-color: #4361ee;
      color: #fff;
      padding: 25px;
      border-radius: 15px 15px 0 0;
      text-align: center;
    }
    .profile-image {
      width: 120px;
      height: 120px;
      object-fit: cover;
      border-radius: 50%;
      border: 5px solid #fff;
      margin-top: -60px;
    }
    .btn-edit {
      background-color: #3f37c9;
      color: #fff;
    }
    .profile-info {
      margin-bottom: 15px;
    }
    .profile-info h6 {
      font-weight: 600;
      margin-bottom: 5px;
    }
  </style>
</head>
<body>

  <!-- Sidebar -->
  <%- include("sidebar") %>

  <!-- Main Content -->
  <div class="main-content">
    <div class="profile-card">
      <div class="profile-header">
        <h3>Admin Profile</h3>
      </div>
      
      <div class="pt-4 px-3">

        <div class="row">
          <div class="col-md-6 profile-info">
            <h6><i class="bi bi-person"></i> Name</h6>
            <p><%= admin.name %></p>
          </div>
          <div class="col-md-6 profile-info">
            <h6><i class="bi bi-envelope"></i> Email</h6>
            <p><%= admin.email %></p>
          </div>
          <div class="col-md-6 profile-info">
            <h6><i class="bi bi-phone"></i> Contact Number</h6>
            <p><%= admin.phone || "9876543210" %></p>
          </div>
          <div class="col-md-6 profile-info">
            <h6><i class="bi bi-shield-lock"></i> Role</h6>
            <p>Super Admin</p>
          </div>
          <div class="col-md-6 profile-info">
            <h6><i class="bi bi-geo-alt"></i> Address</h6>
            <p><%= admin.address || "Newasa, Ahmednagar, MH" %></p>
          </div>
          <div class="col-md-6 profile-info">
            <h6><i class="bi bi-calendar3"></i> Joined On</h6>
            <p>January 2024</p>
          </div>
          <div class="col-md-6 profile-info">
            <h6><i class="bi bi-clock-history"></i> Last Login</h6>
            <p>7 July 2025, 10:45 AM</p>
          </div>
          <div class="col-md-6 profile-info">
            <h6><i class="bi bi-person-badge"></i> Status</h6>
            <p class="text-success fw-bold">Active</p>
          </div>
          <div class="col-md-6 profile-info">
            <h6><i class="bi bi-gender-ambiguous"></i> Gender</h6>
            <p><%= admin.gender || "Male" %></p>
          </div>
          <div class="col-md-6 profile-info">
            <h6><i class="bi bi-calendar2-date"></i> Date of Birth</h6>
            <p><%= admin.dob || "01 Jan 2000" %></p>
          </div>
          <div class="col-md-6 profile-info">
            <h6><i class="bi bi-patch-check-fill"></i> Email Verified</h6>
            <p class="text-success">Yes</p>
          </div>
        </div>

        <div class="text-center mt-4">
          <a href="/admin/edit-profile" class="btn btn-edit px-4"><i class="fa fa-pen me-1"></i> Edit Profile</a>
        </div>
      </div>
    </div>
  </div>

  
  
