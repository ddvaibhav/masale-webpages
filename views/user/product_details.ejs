<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Agri Masala - Premium Spice Blend</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <style>
    :root {
      --turmeric-yellow: #E0B12D;
      --saffron-orange: #D86C1E;
      --off-white: #FDFAF5;
      --saffron-brown: #8A3B0D;
      --spice-light: #F7F1E0;
      --earth-brown: #5D4037;
    }

    body {
      background-color: var(--off-white);
      font-family: 'Poppins', sans-serif;
      color: #333;
      padding: 20px;
    }

    .container {
      max-width: 1200px;
      margin: 0 auto;
    }

    .page-header {
      text-align: center;
      margin-bottom: 40px;
      padding: 20px 0;
      border-bottom: 2px solid var(--spice-light);
    }

    .page-header h1 {
      color: var(--saffron-brown);
      font-weight: 700;
      font-size: 2.5rem;
      margin-bottom: 10px;
    }

    .page-header p {
      color: var(--earth-brown);
      font-size: 1.1rem;
      max-width: 700px;
      margin: 0 auto;
    }

    .image-flip-container {
      position: relative;
      width: 100%;
      height: 450px;
      perspective: 1000px;
      border-radius: 15px;
      overflow: hidden;
      box-shadow: 0 10px 25px rgba(93, 64, 55, 0.1);
      margin-bottom: 30px;
    }

    .image-flip-inner {
      width: 100%;
      height: 100%;
      position: relative;
      transition: transform 0.8s;
      transform-style: preserve-3d;
    }

    .image-flip-container:hover .image-flip-inner {
      transform: rotateY(180deg);
    }

    .image-front, .image-back {
      position: absolute;
      width: 100%;
      height: 100%;
      backface-visibility: hidden;
      object-fit: contain;
      background-color: var(--off-white);
      padding: 20px;
    }

    .image-back {
      transform: rotateY(180deg);
    }

    .product-card {
      background: white;
      border-radius: 15px;
      box-shadow: 0 10px 25px rgba(93, 64, 55, 0.08);
      padding: 30px;
    }

    .product-name {
      color: var(--saffron-brown);
      font-size: 2rem;
      font-weight: 700;
    }

    .product-subtitle {
      color: var(--earth-brown);
      font-size: 1.1rem;
    }

    .price-badge {
      background-color:#ff9933;
      color: white;
      font-weight: 600;
      padding: 10px 20px;
      border-radius: 30px;
      display: inline-block;
      margin: 20px 0;
      box-shadow: 0 4px 8px rgba(141, 110, 99, 0.2);
    }

    .form-select {
      border: 2px solid var(--spice-light);
      border-radius: 10px;
      padding: 12px 15px;
      margin-bottom: 1.5rem;
    }

    .btn-warning-custom {
      background-color:#ff9933;
      border: none;
      font-weight: 600;
      padding: 12px 25px;
      border-radius: 50px;
      color: white;
      transition: all 0.3s;
    }

    .btn-warning-custom:hover {
      transform: translateY(-3px);
      box-shadow: 0 6px 15px rgba(216, 108, 30, 0.35);
      color: black;
    }

    .ingredient-list {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
      gap: 15px;
      margin: 20px 0;
    }

    .ingredient-item {
      background: var(--spice-light);
      padding: 12px 15px;
      border-radius: 10px;
      font-weight: 500;
      color: var(--earth-brown);
    }

    .rating-stars {
      color: #FFC107;
      font-size: 1.2rem;
    }

    .review-count {
      margin-left: 10px;
    }

    .spice-decoration {
      position: absolute;
      z-index: -1;
      opacity: 0.1;
      font-size: 6rem;
    }
  </style>
</head>
<body>
  <!-- Decorative spice elements -->
  <div class="spice-decoration" style="top: 50px; left: 50px;">🌶️</div>
  <div class="spice-decoration" style="top: 150px; right: 50px;">🧅</div>
  <div class="spice-decoration" style="bottom: 100px; left: 100px;">🧄</div>

  <div class="container py-4">
    <!-- Page Header -->
    <div class="page-header">
      <h1><%= product.product_name %></h1>
      <p><%= product.detail %></p>
    </div>

    <div class="row g-5">
      <!-- Image Flip -->
      <div class="col-lg-6">
        <div class="image-flip-container">
          <div class="image-flip-inner">
            <img src="/uploads/<%= product.image %>" class="image-front" alt="Agri Masala Front">
            <img src="/uploads/<%= product.image2 %>" class="image-back" alt="Agri Masala Back">
          </div>
        </div>
        <div class="text-center mt-4">
          <p class="text-muted">Hover over the image to see the ingredients</p>
        </div>

          <div>
            <h5>Product Usage:</h5>
            <p><%=product.usage%></p>
          </div>
          <div>
            <h5>Health Benifits:</h5>
            <p><%=product.health_benifits%></p>
          </div>

      </div>

      <!-- Product Info -->
      <div class="col-lg-6">
        <div class="product-card">
          <h1 class="product-name"><%= product.product_name %></h1>
          <p class="product-subtitle"><%= product.detail %></p>

          <div class="price-badge" id="dynamicPrice">
            <i class="fas fa-tag me-2"></i>₹<%= variants[0]?.price || '0.00' %>
          </div>

          <div class="mb-4">
            <label for="weightSelect" class="form-label fw-medium">Choose Weight:</label>
            <select class="form-select" id="weightSelect">
              <% variants.forEach(v => { %>
                <option value="<%= v.id %>" data-price="<%= v.price %>">
                  <%= v.weight %> - ₹<%= v.price %>
                </option>
              <% }) %>
            </select>
          </div>

          <div class="d-flex align-items-center mb-3 gap-2">
            <label class="fw-medium me-2">Quantity:</label>
            <button class="btn btn-sm btn-outline-secondary" onclick="updateQty(-1)">−</button>
            <input type="number" id="qty" name="quantity" class="form-control text-center" value="1" min="1" style="width: 60px;">
            <button class="btn btn-sm btn-outline-secondary" onclick="updateQty(1)">+</button>
          </div>

          <form action="/add_tocart" method="POST">
            <input type="hidden" name="product_id" value="<%= product.product_id %>">
            <input type="hidden" name="product_name" value="<%= product.product_name %>">
            <input type="hidden" name="weight_id" id="formWeight">
             <input type="hidden" name="price" id="formPrice">
             <input type="hidden" name="quantity" id="formQty" value="1">


            <button type="submit" class="btn btn-warning-custom w-100">
              <i class="fas fa-shopping-cart me-2"></i>Add to Cart
            </button>
          </form>

          <div class="d-flex align-items-center my-4">
            <div class="rating-stars">
              <i class="fas fa-star"></i><i class="fas fa-star"></i>
              <i class="fas fa-star"></i><i class="fas fa-star"></i>
              <i class="fas fa-star-half-alt"></i>
            </div>
            <span class="review-count">4.7 (128 reviews)</span>
          </div>

          <h5 class="section-title">Ingredients</h5>
          <div class="ingredient-list">
            <% product.ingredients.split(',').forEach(item => { %>
              <div class="ingredient-item"><%= item.trim() %></div>
            <% }) %>
          </div>

        
        </div>
      </div>
    </div>
  </div>

  <!-- JavaScript -->
   <script>
 const weightSelect = document.getElementById('weightSelect');
const dynamicPrice = document.getElementById('dynamicPrice');
const formWeight = document.getElementById('formWeight');
const formPrice = document.getElementById('formPrice');
const qtyInput = document.getElementById('qty');
const formQty = document.getElementById('formQty');

function updateFormValues() {
  const selectedOption = weightSelect.options[weightSelect.selectedIndex];
  const price = selectedOption.getAttribute('data-price');
  const weightId = selectedOption.value;

  dynamicPrice.innerHTML = `<i class="fas fa-tag me-2"></i>₹${price}`;
  formWeight.value = weightId;
  formPrice.value = price;
}

weightSelect.addEventListener('change', updateFormValues);

function updateQty(change) {
  let qty = parseInt(qtyInput.value) + change;
  if (qty < 1) qty = 1;
  qtyInput.value = qty;
  formQty.value = qty;
}

// ✅ Fix: Listen to manual input changes
qtyInput.addEventListener("input", () => {
  formQty.value = qtyInput.value;
});

document.querySelector("form").addEventListener("submit", (e) => {
  console.log("Submitted Quantity:", formQty.value);
});

window.onload = () => {
  updateFormValues();
  formQty.value = qtyInput.value; // initialize default qty
};
</script>

</body>
</html>
