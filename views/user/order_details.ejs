<%-include("navbar.ejs") %>

<style>
  .order-details-container {
    max-width: 900px;
    margin: 50px auto;
    background: #fff;
    border-radius: 12px;
    padding: 30px;
    box-shadow: 0 5px 20px rgba(0,0,0,0.05);
    font-family: 'Segoe UI', sans-serif;
  }

  .section-title {
    font-size: 20px;
    font-weight: 600;
    margin-bottom: 15px;
    border-bottom: 2px solid #eee;
    padding-bottom: 5px;
  }

  .order-item {
    display: flex;
    gap: 20px;
    margin-bottom: 20px;
    align-items: flex-start;
  }

  .order-item img {
    width: 80px;
    height: 80px;
    object-fit: cover;
    border: 1px solid #ddd;
    border-radius: 6px;
  }

  .order-item-details {
    flex-grow: 1;
  }

  .label {
    font-weight: 500;
    color: #555;
  }

  .value {
    font-weight: 600;
    color: #333;
  }

  .order-summary {
    margin-top: 30px;
    border-top: 1px solid #ddd;
    padding-top: 15px;
  }

  .order-status {
    font-weight: 600;
    padding: 6px 12px;
    border-radius: 5px;
  }

  .bg-pending { background: #fff3cd; color: #856404; }
  .bg-completed { background: #d4edda; color: #155724; }
  .bg-cancelled { background: #f8d7da; color: #721c24; }

  .text-strike {
    text-decoration: line-through;
    color: #999;
  }

  .text-save {
    color: green;
    font-weight: 600;
  }

  .total-saving-highlight {
    background: #eaf7ea;
    padding: 12px;
    border-radius: 6px;
    font-weight: 600;
    color: #2e7d32;
  }

  .cancel-order-form {
    margin-top: 20px;
  }
</style>

<div class="container order-details-container">
  <h2 class="text-center mb-4">Order Details</h2>

  <!-- Order Info -->
  <div class="mb-4">
    <p><span class="label">Order ID:</span> <span class="value">#ORD<%= order.order_id %></span></p>
    <p><span class="label">Order Date:</span> <%= new Date(order.created_at).toLocaleDateString() %></p>
    <% if (order.date_at) { %>
  <p>
    <span class="label">Order <%= order.order_status %> At:</span> 
    <%= new Date(order.date_at).toLocaleDateString('en-IN', {
      year: 'numeric',
      month: 'short',
      day: 'numeric'
    }) %>
  </p>
<% } %>

    <p>
      <span class="label">Status:</span> 
      <span class="order-status 
        <% if (order.order_status === 'Pending') { %> bg-pending 
        <% } else if (order.order_status === 'Completed') { %> bg-completed 
        <% } else if (order.order_status === 'Cancelled') { %> bg-cancelled <% } %>">
        <%= order.order_status %>
      </span>
    </p>
  </div>

  <!-- Shipping Info -->
  <div class="mb-4">
    <div class="section-title">Shipping Information</div>
    <p><span class="label">Name:</span> <%= order.name %></p>
    <p><span class="label">Phone:</span> <%= order.phone %></p>
    <p><span class="label">Email:</span> <%= order.email %></p>
    <p><span class="label">Address:</span> <%= order.address %>, <%= order.landmark %>, <%= order.city %>, <%= order.state %> - <%= order.pincode %></p>
  </div>

  <!-- Ordered Products -->
  <div>
    <div class="section-title">Ordered Products</div>
    <% let totalSavings = 0; %>
    <% items.forEach(item => {
      const itemTotal = item.discount_price * item.quantity;
      const savedAmount = (item.price - item.discount_price) * item.quantity;
      totalSavings += savedAmount;
    %>
      <div class="order-item">
        <img src="/uploads/<%= item.image %>" alt="">
        <div class="order-item-details">
          <h6><%= item.product_name %></h6>
          <p>
            Price: 
            <span class="text-strike">₹<%= item.price %></span>
            <span class="text-success fw-bold"> ₹<%= item.discount_price %></span>
            × <%= item.quantity %>
          </p>
          <% if (savedAmount > 0) { %>
            <p class="text-save">You saved ₹<%= savedAmount.toFixed(2) %></p>
          <% } %>
        </div>
        <div class="text-end fw-bold">
          ₹<%= itemTotal.toFixed(2) %>
        </div>
      </div>
    <% }) %>
  </div>

  <!-- Order Summary -->
  <div class="order-summary">
    <p><span class="label">Total Quantity:</span> <%= order.quantity %></p>
    <p><span class="label">Total Amount Paid:</span> ₹<%= order.total_amount %></p>
    <% if (totalSavings > 0) { %>
      <div class="total-saving-highlight">
        🎉 You saved ₹<%= totalSavings.toFixed(2) %> on this order!
      </div>
    <% } %>
    <p class="mt-3"><span class="label">Payment Method:</span> <%= order.payment_method %></p>
    <% if (order.payment_method === 'Online') { %>
      <p><span class="label">Payment ID:</span> <%= order.payment_id %></p>
    <% } %>
  </div>

  <!-- Cancel Button -->
  <% if (order.order_status.toLowerCase().trim() === 'pending') { %>
    <form class="cancel-order-form" method="POST" action="/cancel_order/<%= order.order_id %>" onsubmit="return confirm('Are you sure you want to cancel this order?');">
      <button class="btn btn-danger w-100" type="submit">Cancel This Order</button>
    </form>
  <% } %>
</div>
<%- include("footer.ejs") %>
