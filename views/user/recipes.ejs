    <!-- Ingredients and Instructions -->
    <div class="recipe-container py-5">
        <div class="row g-4">
            <!-- Ingredients Section -->
            <div class="col-md-4">
                <div class="recipe-section__header">
                    <h2 class="h4 fw-bold">Ingredients</h2>
                    <p class="mb-0 text-light">For the authentic misal experience</p>
                </div>
                <div class="recipe-section__content">
                    <h5 class="text-warning fw-bold">For Goda Masala:</h5>
                    <p class="text-muted">(Use our special blend or make your own)</p>
                    <ul class="list-unstyled">
                        <li class="recipe-ingredient p-2 border rounded mb-2">2 tbsp our Goda Masale</li>
                        <li class="recipe-ingredient p-2 border rounded mb-2">(or homemade blend)</li>
                    </ul>
                    
                    <h5 class="text-warning fw-bold mt-4">For Misal:</h5>
                    <ul class="list-unstyled">
                        <li class="recipe-ingredient p-2 border rounded mb-2">1 cup sprouted matki (moth beans)</li>
                        <li class="recipe-ingredient p-2 border rounded mb-2">1 large onion, finely chopped</li>
                        <li class="recipe-ingredient p-2 border rounded mb-2">2 tomatoes, pureed</li>
                        <li class="recipe-ingredient p-2 border rounded mb-2">4-5 garlic cloves, minced</li>
                        <li class="recipe-ingredient p-2 border rounded mb-2">1-inch ginger, grated</li>
                        <li class="recipe-ingredient p-2 border rounded mb-2">2 tbsp oil</li>
                        <li class="recipe-ingredient p-2 border rounded mb-2">1 tsp mustard seeds</li>
                        <li class="recipe-ingredient p-2 border rounded mb-2">1 tsp cumin seeds</li>
                        <li class="recipe-ingredient p-2 border rounded mb-2">8-10 curry leaves</li>
                        <li class="recipe-ingredient p-2 border rounded mb-2">1 tsp turmeric powder</li>
                        <li class="recipe-ingredient p-2 border rounded mb-2">1 tbsp jaggery</li>
                        <li class="recipe-ingredient p-2 border rounded mb-2">Salt to taste</li>
                    </ul>
                    
                    <h5 class="text-warning fw-bold mt-4">For Serving:</h5>
                    <ul class="list-unstyled">
                        <li class="recipe-ingredient p-2 border rounded mb-2">Pav (bread rolls)</li>
                        <li class="recipe-ingredient p-2 border rounded mb-2">Farsan (crispy topping)</li>
                        <li class="recipe-ingredient p-2 border rounded mb-2">Chopped onions</li>
                        <li class="recipe-ingredient p-2 border rounded mb-2">Lemon wedges</li>
                        <li class="recipe-ingredient p-2 border rounded mb-2">Fresh coriander</li>
                    </ul>
                </div>
            </div>
            
            <!-- Instructions Section -->
            <div class="col-md-8">
                <div class="recipe-section__header">
                    <h2 class="h4 fw-bold">Instructions</h2>
                    <p class="mb-0 text-light">Step-by-step guide to authentic Misal Pav</p>
                </div>
                <div class="recipe-section__content">
                    <div class="mb-4">
                        <div class="d-flex">
                            <div class="recipe-step__number">1</div>
                            <div>
                                <h5>Prepare the Sprouts</h5>
                                <p>Pressure cook sprouted matki with 1/2 tsp turmeric and salt (3 whistles). Drain and set aside.</p>
                                <img src="https://storage.googleapis.com/workspace-0f70711f-8b4e-4d94-86f1-2a93ccde5887/image/a0a5fcca-06ec-4c85-9cd0-c0033633da5e.png" class="recipe-step__image rounded mt-2" alt="Sprouted matki cooking">
                            </div>
                        </div>
                    </div>
                    
                    <div class="mb-4">
                        <div class="d-flex">
                            <div class="recipe-step__number">2</div>
                            <div>
                                <h5>Tempering (Tadka)</h5>
                                <p>Heat oil, add mustard seeds, cumin, and curry leaves. When they splutter, add onions and sauté. Then add ginger-garlic paste.</p>
                                <img src="https://storage.googleapis.com/workspace-0f70711f-8b4e-4d94-86f1-2a93ccde5887/image/5a209057-537e-4492-8dd8-c9d4ab909723.png" class="recipe-step__image rounded mt-2" alt="Tadka process">
                            </div>
                        </div>
                    </div>
                    
                    <div class="mb-4">
                        <div class="d-flex">
                            <div class="recipe-step__number">3</div>
                            <div>
                                <h5>Add Spices & Cook</h5>
                                <p>Add tomato puree and cook until oil separates. Then add Goda Masale, turmeric, jaggery. Cook 2–3 mins.</p>
                            </div>
                        </div>
                    </div>
                    
                    <div class="mb-4">
                        <div class="d-flex">
                            <div class="recipe-step__number">4</div>
                            <div>
                                <h5>Combine & Simmer</h5>
                                <p>Add sprouts and 2 cups water. Boil, then simmer for 10–15 mins. Adjust salt & spice.</p>
                            </div>
                        </div>
                    </div>
                    
                    <div class="mb-4">
                        <div class="d-flex">
                            <div class="recipe-step__number">5</div>
                            <div>
                                <h5>Prepare Accompaniments</h5>
                                <p>Chop onions, coriander, lemon wedges. Toast pav in butter if desired.</p>
                                <img src="https://storage.googleapis.com/workspace-0f70711f-8b4e-4d94-86f1-2a93ccde5887/image/ba08088d-d5be-410d-9b0f-34a6177739cd.png" class="recipe-step__image rounded mt-2" alt="Accompaniments">
                            </div>
                        </div>
                    </div>
                    
                    <div class="mb-4">
                        <div class="d-flex">
                            <div class="recipe-step__number">6</div>
                            <div>
                                <h5>Serve Hot</h5>
                                <p>Layer farsan in a bowl, pour hot misal, top with farsan, onion, coriander, lemon. Serve with pav.</p>
                                <img src="https://storage.googleapis.com/workspace-0f70711f-8b4e-4d94-86f1-2a93ccde5887/image/93600282-e584-446e-944c-0ce367850630.png" class="recipe-step__image rounded mt-2" alt="Final misal pav dish">
                            </div>
                        </div>
                    </div>
                    
                    <!-- Chef's Tips -->
                    <div class="recipe-tip mt-5 p-4 rounded">
                        <h5 class="recipe-tip__title">Chef's Tips:</h5>
                        <ul class="mt-2">
                            <li>• Add 1/4 cup grated coconut with tomato for richness</li>
                            <li>• Goda Masala includes dagad phool (black stone flower)</li>
                            <li>• Let misal sit for 30 mins after cooking for deeper flavor</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
    
